{
    "name": "jutge-open-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "update-jutge-client": "cd lib ; rm -f jutge_api_client.ts ; jutge clients typescript",
        "clean": "rm -rf .next",
        "dev": "bun --bun next dev",
        "build": "bun --bun next build",
        "start": "bun --bun next start",
        "format": "bun prettier --write --list-different .",
        "lint": "eslint",
        "knip": "knip",
        "docker-build": "docker build --build-arg NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY -t web-new .",
        "docker-build-amd64": "docker build --build-arg NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY --platform linux/amd64/v2 -t web-new .",
        "docker-run": "docker run -p 8015:8015 web-new",
        "deploy-minipc": "ssh -t minipc 'cd Projectes/jutge-web-new && pm2 stop jutge && git pull && bun install && bun run build && pm2 restart jutge'",
        "deploy-jutge": "bun run docker-build-amd64 && (docker save web-new | ssh jutge@jutge.org 'docker load') && ssh jutge@jutge.org 'docker compose up -d --force-recreate'",
        "deploy": "bun run build && bun run deploy-minipc && bun run deploy-jutge"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
