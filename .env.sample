# Copy this file to `.env` and adjust values for local development.

# Secret (≥ 32 characters) used to sign session JWTs.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Jutge API base URL (optional; defaults to https://api.jutge.org/api).
# JUTGE_API_URL=https://api.jutge.org/api
# NEXT_PUBLIC_JUTGE_API_URL=https://api.jutge.org/api
# NEXT_PUBLIC_JUTGE_EXAM_API_URL=https://exam.api.jutge.org/api
# NEXT_PUBLIC_JUTGE_CONTEST_API_URL=https://contest.api.jutge.org/api

# Optional forwarded host header for API requests (production / reverse-proxy setups).
# Normal mode only. Exam and contest hosts do not send this header; they call
# https://exam.api.jutge.org/api and https://contest.api.jutge.org/api.
# JUTGE_DOMAIN=jutge.org

# Optional JSON map of hostname to "normal", "exam", or "contest".
# A change is picked up on the next build. Unknown hosts stay in normal mode.
# NEXT_PUBLIC_SITE_MODE_HOSTS={"exam.example.net":"exam","contest.example.net":"contest"}

# Set by Next.js automatically in development and production.
# NODE_ENV=development
